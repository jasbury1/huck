//
//  App.xcconfig
//  Huck
//
//  Settings for the app target, shared by its Debug and Release
//  configurations. Debug.xcconfig and Release.xcconfig include this, then the
//  optional, untracked Local.xcconfig. Settings every target shares live in
//  Base.xcconfig.
//
//  Swift reads the feature switches below through `BuildConfiguration.swift`,
//  and only there. Custom switches are prefixed HUCK_ so they're easy to tell
//  apart from Xcode's own settings.
//
//  Adding a switch:
//  - On/off feature: declare HUCK_<NAME> = NO below, map YES to a Swift
//    compilation condition the way HUCK_ICLOUD_SYNC does, and expose it as a
//    property on `BuildConfiguration`.
//  - Typed value (string, number, URL): declare it here, pass it through an
//    Info.plist key as $(HUCK_<NAME>), and read it in `BuildConfiguration`
//    with `Bundle.main.object(forInfoDictionaryKey:)`.
//

// MARK: - Identity

PRODUCT_NAME = $(TARGET_NAME)
PRODUCT_BUNDLE_IDENTIFIER = $(HUCK_BUNDLE_ID_PREFIX).Huck

// The version people see, and the build number. Xcode Cloud manages the build
// number for archives it uploads, so bump only MARKETING_VERSION by hand.
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// MARK: - Info.plist

GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Huck
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.news
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight

// MARK: - Resources

ASSETCATALOG_COMPILER_APPICON_NAME = HuckIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
STRING_CATALOG_GENERATE_SYMBOLS = YES
SWIFT_EMIT_LOC_STRINGS = YES

// Shipped only to previews, never to the App Store.
DEVELOPMENT_ASSET_PATHS = "Huck/Preview Content"
ENABLE_PREVIEWS = YES

LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks

// MARK: - Feature switches

// iCloud sync for collections. Needs the iCloud key-value entitlement, which
// only a paid Apple Developer Program team can provision, so this one switch
// adds both the entitlement and the ICLOUD_SYNC compilation condition. Turn it
// on in Local.xcconfig rather than here.
HUCK_ICLOUD_SYNC = NO

HUCK_ICLOUD_SYNC_ENTITLEMENTS_YES = Config/Huck-iCloud.entitlements
HUCK_ICLOUD_SYNC_ENTITLEMENTS_NO =
HUCK_ICLOUD_SYNC_CONDITION_YES = ICLOUD_SYNC
HUCK_ICLOUD_SYNC_CONDITION_NO =

// Hard-disables writing to Hacker News: comments, posts, and deletions are
// never sent, whatever the Dry Run setting says. For builds that must not post
// — testing against a real account, say. Turn it on in Local.xcconfig.
HUCK_DISABLE_POSTING = NO

HUCK_DISABLE_POSTING_CONDITION_YES = POSTING_DISABLED
HUCK_DISABLE_POSTING_CONDITION_NO =

// MARK: - Derived settings

CODE_SIGN_ENTITLEMENTS = $(HUCK_ICLOUD_SYNC_ENTITLEMENTS_$(HUCK_ICLOUD_SYNC))
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) $(HUCK_ICLOUD_SYNC_CONDITION_$(HUCK_ICLOUD_SYNC)) $(HUCK_DISABLE_POSTING_CONDITION_$(HUCK_DISABLE_POSTING))
